# Copie para .env (`cp .env.example .env`) e troque os valores.
# O arquivo .env está no .gitignore: nunca faça commit dele.

POSTGRES_DB=pipeline
POSTGRES_USER=pipeline
# Defina uma senha própria (obrigatória; o docker compose recusa subir sem ela).
POSTGRES_PASSWORD=troque-esta-senha

# Usados quando o pipeline roda fora do Docker (make run-local).
# Dentro do docker compose o host é sobrescrito para "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Fontes de dados: ai4i (baixa o CSV do UCI) e/ou simulado (gerador com semente fixa)
PIPELINE_FONTES=ai4i,simulado
PIPELINE_SEMENTE=42
